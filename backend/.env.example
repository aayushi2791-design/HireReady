# HireReady Environment Variables
# Copy this to .env and fill in your values

PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/hireready

# JWT Secret (use a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars

# JWT Expiry
JWT_EXPIRE=7d

# 1. Groq API Key (Primary Free AI: Llama 3.3 70B - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Gemini API Key (Backup Free AI - https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Authentication (https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# File upload limits (in bytes)
MAX_FILE_SIZE=5242880
